[Unit]
# The real daemon, supervised. tools/live-daemon.sh installs this as a systemd user unit and starts it; it used to
# start the daemon with setsid + nohup, which outlives the caller but not a WSL restart, and nothing started it again
# (2026-10-18: the tablet sat on "down" for hours after WSL came back). Restart=always also covers a crash.
Description=clayclaude daemon (the tablet board)
After=network-online.target
Wants=network-online.target
# Never give up restarting. A [Unit] key: under [Service] systemd ignores it.
StartLimitIntervalSec=0

[Service]
Type=simple
# Written by tools/live-daemon.sh: CLAYCLAUDE_WT (the built worktree to serve), CLAYCLAUDE_NODE (its node binary; a
# systemd user unit gets no nvm PATH) and the variables it carries over from the shell that ran it (see the script).
# The optional env file is yours: NAME=value lines that should reach the daemon on every start, such as a token for
# a `tokenEnv` or CLAYCLAUDE_CHROMIUM. It is read second, so it wins.
EnvironmentFile=%h/.config/clayclaude/daemon.env
EnvironmentFile=-%h/.config/clayclaude/env
# The same guard live-daemon.sh runs: never poll oauth usage with refresh on.
ExecStartPre=/bin/sh -c 'exec "$CLAYCLAUDE_NODE" "$CLAYCLAUDE_WT/tools/refresh-guard.mjs" "$HOME/.config/clayclaude/config.yaml"'
ExecStart=/bin/sh -c 'cd "$CLAYCLAUDE_WT" && exec "$CLAYCLAUDE_NODE" dist/cli.js serve'
Restart=always
RestartSec=5
# Not /tmp: a WSL restart empties it, and with it the log of what happened before.
StandardOutput=append:%h/.local/state/clayclaude/serve.log
StandardError=append:%h/.local/state/clayclaude/serve.log

[Install]
WantedBy=default.target
